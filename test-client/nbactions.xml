<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <displayName>Run Event Timing Test Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:java</goal>
        </goals>
        <properties>
            <exec.mainClass>io.github.brainboxemb.eventtiming.testclient.TestClientApplication</exec.mainClass>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <displayName>Debug Event Timing Test Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:java</goal>
        </goals>
        <properties>
            <exec.mainClass>io.github.brainboxemb.eventtiming.testclient.TestClientApplication</exec.mainClass>
            <jpda.listen>maven</jpda.listen>
        </properties>
    </action>
</actions>
