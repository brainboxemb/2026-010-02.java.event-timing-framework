<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.brainboxemb.eventtiming</groupId><artifactId>event-timing-framework</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>timing-app</artifactId>
  <name>Timing Application</name>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>timing-runtime</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>timing-adapters</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>timing-testkit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.brainboxemb.eventtiming.app.TimingApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
